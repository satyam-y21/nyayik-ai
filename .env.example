# Nyayik AI: Indian Legal RAG Assistant - Environment Configuration

# LLM Provider: openai, gemini, ollama, groq
LLM_PROVIDER=ollama
MODEL_NAME=llama3

# API Keys (Required if using cloud LLM providers)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Embedding Configuration: local (HuggingFace), openai, gemini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Vector database settings (faiss, qdrant)
VECTOR_DB_PROVIDER=faiss
VECTOR_DB_DIR=./Vectorstore/faiss_index
DATA_RAW_DIR=./Data/raw
DATA_PROCESSED_DIR=./Data/processed

# Qdrant Cloud Configuration (Required only if VECTOR_DB_PROVIDER=qdrant)
QDRANT_URL=your_qdrant_cloud_cluster_url_here
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION=legal_documents

# Score threshold for filtering out irrelevant RAG context
RETRIEVAL_SCORE_THRESHOLD=0.65

# Performance & Metrics Logging Toggle (Set to true to collect local JSONL request performance metrics)
ENABLE_PERFORMANCE_LOGGING=false
LOG_QUERY_TEXT=false
PERFORMANCE_LOG_DIR=./Backend/logs

